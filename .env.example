# PostgreSQL & AWS Secrets Manager Configuration for Analytics Studio Lambda Functions

# Option 1: AWS Secrets Manager Secret ARN holding RDS Proxy database credentials
# Secret JSON format: {"username": "...", "password": "...", "engine": "postgres", "host": "...", "port": 5432, "dbname": "..."}
DB_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:123456789012:secret:analytics-db-credentials

# Option 2: Direct environment variables (used for local development / testing)
DB_HOST=analytics-db.example.rds.amazonaws.com
DB_PORT=5432
DB_NAME=superblockhq
DB_USER=analytics_user
DB_PASSWORD=your_secure_password
DB_SSL=true
